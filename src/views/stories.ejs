<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <%- include('partials/page-hero', {
    eyebrow: 'Реальні справи OM DAYA',
    pageTitle: 'Те, що вже стало можливим',
    lead: 'Що ми зробили, скільки це коштувало і що змінилося: тексти, фото та звіти за кожною справою. Фото й історії публікуємо лише за згодою.'
  }) %>

  <section style="padding-top:20px;">
    <div class="wrap">
      <% if (stories.length === 0) { %>
        <div style="background:var(--lavender); border-radius:var(--radius); padding:26px; max-width:720px;">
          <p style="color:var(--ink-soft);">OM DAYA лише починає свій шлях. Перші матеріали з’являться тут після завершення та документального закриття відповідних проєктів — ми не публікуємо того, чого ще немає.</p>
        </div>
      <% } else { %>
      <div class="story-grid">
        <% stories.forEach(s => { %>
          <a class="story-mini" href="/stories/<%= s.id %>" style="display:block; color:inherit;">
            <div class="story-mini-media">
              <% if (s.image_url) { %>
                <img src="<%= s.image_url %>" alt="<%= s.title %>" style="width:100%; height:100%; object-fit:cover;">
              <% } else { %>
                <span class="ph-label" style="font-size:12px; font-weight:700; color:var(--ink-soft); background:#fff; padding:5px 12px; border-radius:100px; border:1.4px dashed #D9C9D4;">фото</span>
              <% } %>
            </div>
            <div class="story-mini-body">
              <span class="eyebrow">Реальна справа</span>
              <% if (s.status) { %><span class="report-status" style="margin-left:8px; font-size:11px; padding:4px 10px;"><%= s.status %></span><% } %>
              <h3><%= s.title %></h3>
              <p><%= s.excerpt %></p>
              <span class="more" style="display:inline-block; margin-top:10px;">Читати →</span>
            </div>
          </a>
        <% }) %>
      </div>
      <% } %>
    </div>
  </section>

  <section class="stats-section">
    <div class="wrap">
      <div class="cta-band" style="background:transparent; box-shadow:none; padding:0;">
        <h2>Хочете, щоб таких історій було більше?</h2>
        <p>Ваша підтримка допомагає нам супроводжувати ще більше родин.</p>
        <a href="/donate" class="btn btn-ghost">Підтримати</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
