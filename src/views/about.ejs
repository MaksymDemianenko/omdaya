<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <%- include('partials/page-hero', {
    eyebrow: settings.mission_eyebrow,
    pageTitle: settings.mission_title,
    lead: settings.mission_text
  }) %>

  <section style="padding-top:0;">
    <div class="wrap" style="max-width:800px;">
      <p style="font-family:'Fraunces',serif; font-style:italic; font-size:20px; color:var(--magenta); line-height:1.6;"><%= settings.mission_quote %></p>
    </div>
  </section>

  <section style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow"><%= settings.history_eyebrow %></span>
        <h2><%= settings.history_title %></h2>
        <p><%= settings.history_lead %></p>
      </div>
      <div style="max-width:760px; color:var(--ink-soft); font-size:16px; line-height:1.85;">
        <% settings.history_body.split('\n\n').forEach(paragraph => { %>
          <p style="margin-bottom:18px;"><%= paragraph %></p>
        <% }) %>
      </div>
      <div style="max-width:760px; background:var(--lavender); border-radius:var(--radius); padding:30px 34px; margin-top:10px;">
        <% settings.history_highlight.split('. ').filter(Boolean).forEach((line, idx, arr) => { %>
          <p style="font-family:'Fraunces',serif; font-size:19px; color:var(--ink);"><%= line %><%= idx < arr.length - 1 ? '.' : '' %></p>
        <% }) %>
      </div>
    </div>
  </section>

  <section class="stats-section">
    <div class="wrap">
      <div class="section-head center">
        <span class="eyebrow">Найважливіше</span>
        <h2 style="font-size:clamp(22px,3vw,30px); max-width:22ch; margin-left:auto; margin-right:auto;"><%= settings.values_text %></h2>
      </div>
      <div style="max-width:520px; margin:34px auto 0; text-align:center;">
        <% settings.values_lines.split('\n').forEach(line => { %>
          <p style="font-family:'Fraunces',serif; font-size:19px; color:#fff; margin-bottom:14px;"><%= line %></p>
        <% }) %>
      </div>
    </div>
  </section>

  <% if (parseVideos(settings.about_videos).length) { %>
  <section style="padding-top:0;">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Відео</span>
        <h2>Про фонд — у відео</h2>
      </div>
      <%- include('partials/videos', { list: parseVideos(settings.about_videos) }) %>
    </div>
  </section>
  <% } %>

  <% if (team.length) { %>
  <section class="pillars">
    <div class="wrap">
      <div class="section-head">
        <span class="eyebrow">Команда</span>
        <h2>Люди фонду</h2>
        <p>Команда, яка щодня втілює місію фонду в життя.</p>
      </div>
      <div class="team-grid">
        <% team.forEach(t => { %>
          <div class="team-card">
            <div class="team-photo">
              <% if (t.photo_url) { %>
                <img src="<%= t.photo_url %>" alt="<%= t.name %>" style="width:100%; height:100%; object-fit:cover; border-radius:20px;">
              <% } else { %>
                <span class="ph-label">фото</span>
              <% } %>
            </div>
            <h4><%= t.name %></h4>
            <span><%= t.role %></span>
          </div>
        <% }) %>
      </div>
    </div>
  </section>

  <% } %>

  <section>
    <div class="wrap">
      <div class="cta-band">
        <h2>Долучайтесь до нашої місії</h2>
        <p>Ваша підтримка допомагає дітям відкривати безпечніший і самостійніший формат життя.</p>
        <a href="/donate" class="btn btn-ghost">Підтримати фонд</a>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
