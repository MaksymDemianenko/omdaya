<% const contactWay = filled(settings.contact_email) ? 'на ' + settings.contact_email : 'через форму на сторінці «Контакти»';
   const contactTarget = filled(settings.contact_email) ? settings.contact_email : 'форма на сторінці «Контакти»';
   const isDraft = settings.legal_draft !== '0'; %>
<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <%- include('partials/page-hero', {
    eyebrow: 'Юридична інформація',
    pageTitle: 'Публічна оферта',
    lead: 'Умови здійснення благодійних пожертв на користь фонду.'
  }) %>

  <section>
    <div class="wrap" style="max-width:800px;">
      <% if (isDraft) { %>
      <p style="margin-bottom:18px;"><span class="placeholder-tag">чернетка — перевірити з юристом перед публікацією</span></p>
      <% } %>

      <div style="color:var(--ink-soft); font-size:15px; line-height:1.8;">
        <h3 style="color:var(--ink); font-size:18px; margin:26px 0 10px;">1. Загальні положення</h3>
        <p><%= settings.org_legal_name %> (далі — «Фонд») пропонує будь-якій фізичній або юридичній особі (далі — «Благодійник») здійснити добровільну пожертву на статутну діяльність Фонду на умовах цієї оферти.</p>

        <h3 style="color:var(--ink); font-size:18px; margin:26px 0 10px;">2. Порядок здійснення пожертви</h3>
        <p>Пожертва здійснюється через посилання на офіційні платформи зборів коштів, розміщені на сторінці «Підтримати», або банківським переказом за реквізитами, вказаними на сайті. Здійснюючи пожертву, Благодійник підтверджує ознайомлення та згоду з умовами цієї оферти.</p>

        <h3 style="color:var(--ink); font-size:18px; margin:26px 0 10px;">3. Використання коштів</h3>
        <p>Кошти використовуються Фондом на статутну діяльність — підтримку дітей та родин, психологічну та освітню допомогу, реабілітаційні програми — відповідно до напрямів роботи, зазначених на сайті.</p>

        <h3 style="color:var(--ink); font-size:18px; margin:26px 0 10px;">4. Повернення пожертви</h3>
        <p>Пожертва є добровільною безповоротною допомогою і, за загальним правилом, поверненню не підлягає, окрім випадків, передбачених законодавством.</p>

        <h3 style="color:var(--ink); font-size:18px; margin:26px 0 10px;">5. Контакти</h3>
        <p>З питань щодо пожертв звертайтесь: <%= contactTarget %></p>

        <% if (isDraft) { %>
        <p style="margin-top:26px; font-size:13px;">Дата останнього оновлення: <span class="placeholder-tag">вказати дату публікації</span></p>
        <% } %>
      </div>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
