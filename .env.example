# Скопіюйте цей файл у .env і заповніть реальними значеннями.
# .env НЕ комітиться в git — там секрети.

# Порт, на якому запускається сайт
PORT=3000

# Пароль для входу в адмінку (простий варіант — для локальної розробки)
ADMIN_PASSWORD=change-me

# Або — безпечніший варіант: bcrypt-хеш пароля (якщо задано, має пріоритет над ADMIN_PASSWORD)
# Згенерувати хеш: node -e "console.log(require('bcryptjs').hashSync('ваш-пароль', 10))"
ADMIN_PASSWORD_HASH=

# Секрет для підпису сесій — задайте будь-який довгий випадковий рядок
SESSION_SECRET=change-me-too

# Шлях до файлу бази даних (за замовчуванням — data.sqlite в корені проєкту)
DB_PATH=./data.sqlite

# Адреса сайту (для og:image у соцмережах) — заповниться після деплою, напр. https://omdaya.care
# Також можна задати в адмінці → Налаштування

# --- Email-сповіщення (необов'язково) ---
# Якщо залишити пустими — форма контактів і підписка все одно працюють,
# просто без листа-сповіщення (дані все одно зберігаються в базі, видно в адмінці).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_TO_EMAIL=

